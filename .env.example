# Docker Compose environment variables

# Unbound DNS
UNBOUND_PORT=53
# Tor
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051

# wstunnel proxy
LL_IPV4_ADDR=127.0.0.1
LLP_SOCKS5_PROXY=41080
LLP_HTTP_PROXY=43128

# TOR_BALANCE=0 / WSTUNNEL_BALANCE=100 — весь обычный трафик через wstunnel;
# адреса из tor-only-ips.txt всё равно идут в Tor (с fallback на wstunnel, если Tor лежит).
# TOR_BALANCE=0
# WSTUNNEL_BALANCE=100
# BLOCK_IPV6=1

# Monitoring (Grafana / Prometheus / iptables-exporter)
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
EXPORTER_PORT=9101
# EXPORTER_INTERVAL=5
